# Builds the checked-out source tree (no download), used by .github/workflows/arch-package.yml.
# Local use: cd packaging/arch && makepkg -si
pkgname=opencadstudio
_id=io.github.HakanSeven12.OpenCadStudio
pkgdesc='CAD application for 2D/3D drawing with DWG/DXF support'
arch=('x86_64')
url='https://github.com/HakanSeven12/OpenCADStudio'
license=('GPL-3.0-only')
# winit/wgpu dlopen the display, GL and Vulkan libraries at run time.
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libglvnd' 'vulkan-icd-loader'
         'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libxkbcommon' 'wayland')
optdepends=('xdg-desktop-portal: native file dialogs'
            'vulkan-driver: GPU rendering')
makedepends=('cargo' 'git' 'pkgconf')
options=('!lto' '!debug') # makepkg's debug flags (-Cdebuginfo=2) make rustc OOM on a 7 GB runner
source=()
pkgver=0
pkgrel=1
_root="$(realpath "$startdir/../..")"

pkgver() {
  sed -n 's/^version = "\(.*\)"/\1/p' "$_root/Cargo.toml" | head -1
}

build() {
  cd "$_root"
  cargo build --release --locked
}

package() {
  cd "$_root"
  install -Dm755 target/release/OpenCADStudio "$pkgdir/usr/bin/OpenCADStudio"
  install -Dm644 packaging/OpenCADStudio.desktop "$pkgdir/usr/share/applications/$_id.desktop"
  install -Dm644 packaging/$_id.metainfo.xml "$pkgdir/usr/share/metainfo/$_id.metainfo.xml"
  install -Dm644 assets/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_id.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
